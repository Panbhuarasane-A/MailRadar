# ==========================================
# MailRadar Server Environment Configuration
# ==========================================

PORT=4000
NODE_ENV=production

# PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Examples:
# Local Docker: postgresql://postgres:postgres@localhost:5432/mailradar?schema=public
# Supabase:     postgresql://postgres.xxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?schema=public
# Neon:         postgresql://USER:PASSWORD@ep-xyz.us-east-2.aws.neon.tech/mailradar?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailradar?schema=public"

# Anthropic Claude API Key (Optional: for AI classifications)
ANTHROPIC_API_KEY=""

# Google OAuth 2.0 Credentials (for Gmail Sync)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""

# Microsoft OAuth (for Outlook Sync)
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
